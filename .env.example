# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# docker compose reads `.env` automatically. These are LOCAL DEV defaults only —
# do not use these credentials anywhere real.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=packetquest
MYSQL_USER=pquser
MYSQL_PASSWORD=pqpassword
# Host port for MySQL (container always listens on 3306). 3307 avoids clashing
# with a local MySQL install.
MYSQL_PORT=3307

# --- Service host ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8080

# --- Simulator (optional incident generator) ---
# Leave SESSION_ID blank to run the simulator in print-only mode. Set it to a
# live session id to feed incidents into that match:
#   SESSION_ID=<id> docker compose up simulator
SESSION_ID=
SIMULATOR_SEED=42
# 0 = run forever; a positive number emits that many incidents then stops.
SIMULATOR_COUNT=0
